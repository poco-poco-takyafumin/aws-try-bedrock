# ============================================================================
# ★人間レビュー必須（CLAUDE.md: コスト管理設定）
#
# aws_ce_cost_allocation_tag はタグキー単位でAWSアカウント全体に1つしか存在できない
# シングルトンリソース。各ユースケースがCostCenterタグ付きのApplication Inference
# Profile等を作成しても、このタグをCost Explorerで集計可能にする「有効化」自体は
# アカウントに1回で足りる。ユースケースごとのTerraform（docs/0X-xxx/infra）では
# 重複作成しないこと。
#
# 注意: タグキーがAWS側で「認識」されるまでに、実際の請求データ発生から最大24時間程度の
# ラグがある。該当タグを使うリソースがまだ一つも存在しない状態でapplyすると失敗する
# 可能性があるため、その場合は各ユースケース側でタグ付きリソースを作成した後に
# 再applyすること。
# ============================================================================

resource "aws_ce_cost_allocation_tag" "cost_center" {
  tag_key = "CostCenter"
  status  = "Active"
}
